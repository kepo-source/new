{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22",
    "python": "3.12"
  },
  "steps": {
    "build": {
      "commands": [
        "...",
        "python3 -m pip install --no-cache-dir --target /app/.hermes-pkg hermes-agent==0.19.0",
        "mkdir -p /app/.hermes-bin",
        "printf '%s\\n' '#!/bin/sh' 'export PYTHONPATH=/app/.hermes-pkg' 'exec python3 /app/.hermes-pkg/bin/hermes \"$@\"' > /app/.hermes-bin/hermes",
        "chmod +x /app/.hermes-bin/hermes"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "paths": ["/app/.hermes-bin"],
    "variables": {
      "HERMES_HOME": "/app/.hermes",
      "HERMES_BIN": "/app/.hermes-bin/hermes"
    }
  }
}
