{
  "name": "second-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram second brain dengan multi-provider LLM (Groq/Gemini/xAI) dan logging Google Sheets",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/bot.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bot.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "chatid": "tsx scripts/chat-id.ts",
    "setup:sheets": "tsx scripts/setup-sheets.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "grammy": "^1.34.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
