# === Telegram ===
# Token bot @badasht_bot dari @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAH...

# User ID Telegram yang boleh memakai bot (whitelist Hermes gateway).
# Pisahkan dengan koma kalau lebih dari satu.
TELEGRAM_ALLOWED_USERS=1721126502

# === Provider LLM utama: xKiro (3 key berurutan) ===
# Gateway OpenAI-compatible di https://api.xkiro.com/v1.
# Urutan rotasi: XKIRO_API_KEY → XKIRO_API_KEY_2 → XKIRO_API_KEY_3.
# Key didaftarkan ke /opt/data/auth.json oleh skrip seed saat first boot
# (priority 0/1/2, strategi fill_first). Jangan taruh key di config.yaml.
XKIRO_API_KEY=...
XKIRO_API_KEY_2=...
XKIRO_API_KEY_3=...

# Model default Hermes (free tier di xKiro). Diatur di hermes/seed/config.yaml.
# XKIRO_MODEL=mistralai/mistral-medium-3.5

# === Fallback Live (dipakai hanya kalau ketiga key xKiro habis/cooldown) ===
GEMINI_API_KEY=...
GROQ_API_KEY=...

# === Google Sheets (logging wajib untuk /sb-stats dan /sb-budget) ===
# Spreadsheet yang SUDAH ADA — tab `messages`, header A1:J1:
#   ts, chat_id, role, model, prompt_chars, tokens_in, tokens_out,
#   latency_ms, cost_usd, routed_by
GOOGLE_SHEETS_ID=...
# Service account JSON di-base64 satu baris: base64 -w0 service-account.json
GOOGLE_SA_B64=...

# === Operasional ===
# Patokan laporan biaya (/sb-stats, /sb-budget), bukan pembatas request.
DAILY_BUDGET_USD=1.00
TZ=Asia/Jakarta
LOG_LEVEL=info

# === Catatan Railway ===
# Image: Dockerfile (FROM nousresearch/hermes-agent:latest)
# Volume: /opt/data  (berisi config.yaml, auth.json, skills/, plugins/, sessions/)
# HERMES_HOME=/opt/data sudah diset image; tidak perlu diisi manual.
# Healthcheck tidak dipakai: bot Telegram tidak punya endpoint HTTP.
# Saat cutover, matikan service bot TypeScript LAMA dulu sebelum Hermes start
# supaya token @badasht_bot tidak dipakai dua instance (409 Conflict).
