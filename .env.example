# === Telegram ===
# Dapat dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAH...

# Chat ID yang boleh memakai bot (pisahkan dengan koma kalau lebih dari satu).
# Ambil dengan: npm run chatid
ALLOWED_CHAT_IDS=123456789

# === Provider LLM (minimal satu harus diisi) ===

# Gemini — Google AI Studio (format key: AIza...)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash

# Grok — xAI (format key: xai-...)
XAI_API_KEY=...
GROK_MODEL=grok-4
# XAI_BASE_URL=https://api.x.ai/v1

# Groq Cloud — OpenAI-compatible (format key: gsk_...)
# Jangan tertukar: Groq (gsk_) bukan Grok (xai-).
GROQ_API_KEY=...
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Opsional: tentukan provider default & deep.
# Harus salah satu dari: gemini, groq, grok.
# Kalau dikosongkan, otomatis pilih yang tersedia.
# DEFAULT_PROVIDER=gemini
# DEEP_PROVIDER=groq

# === Google Sheets (opsional; kalau kosong, logging dimatikan) ===
GOOGLE_SHEETS_ID=...
# Isi service-account JSON yang sudah di-base64:
#   base64 -w0 service-account.json
GOOGLE_SA_B64=...

# === Budget & operasional ===
# Budget harian menahan Grok xAI kalau sudah lewat batas.
DAILY_BUDGET_USD=1.00
LOG_LEVEL=info
TZ=Asia/Jakarta
# PORT diisi otomatis oleh Railway; lokal default 8080
# PORT=8080
