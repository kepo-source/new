# === Telegram ===
# Dapat dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAH...

# Chat ID yang boleh memakai bot (pisahkan dengan koma kalau lebih dari satu).
# Ambil dengan: npm run chatid
ALLOWED_CHAT_IDS=123456789

# Mode koneksi Telegram: auto | webhook | polling
# auto = webhook kalau PUBLIC_DOMAIN/RAILWAY_PUBLIC_DOMAIN ada, kalau tidak polling.
# Webhook lebih stabil di cloud (tidak kena 409 "terminated by other getUpdates").
TELEGRAM_MODE=auto
# Domain publik untuk webhook. Di Railway otomatis dari RAILWAY_PUBLIC_DOMAIN,
# tapi bisa diisi manual (tanpa https://).
# PUBLIC_DOMAIN=contoh.up.railway.app
# TELEGRAM_WEBHOOK_SECRET=...  # opsional; kalau kosong diturunkan dari token
# TELEGRAM_WEBHOOK_PATH=/telegram

# === Provider LLM: xKiro (utama, 3 key) + Gemini/Groq (fallback) ===
# Gemini — Google AI Studio (format key sekarang: AQ.…)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash-lite
# Thinking: minimal | low | medium | high | xhigh (low = paling cepat)
GEMINI_THINKING_LEVEL=low

# Groq — fallback terakhir kalau semua key xKiro & Gemini kena limit (format: gsk_...)
GROQ_API_KEY=...
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# xKiro — gateway OpenAI-compatible; format model `vendor/model`.
# 3 key dipakai berurutan: xkiro → xkirov2 → xkirov3 → Gemini → Groq.
# Key dibuat di https://xkiro.com/ (jangan commit .env).
XKIRO_API_KEY=...
XKIRO_API_KEY_V2=...
XKIRO_API_KEY_V3=...
XKIRO_MODEL=mistralai/mistral-large-2512
# Opsional: beda model/base URL per key (kalau kosong, pakai XKIRO_MODEL/XKIRO_BASE_URL)
# XKIRO_MODEL_V2=mistralai/mistral-large-2512
# XKIRO_MODEL_V3=mistralai/mistral-large-2512
# XKIRO_BASE_URL=https://api.xkiro.com/v1
# XKIRO_BASE_URL_V2=https://api.xkiro.com/v1
# XKIRO_BASE_URL_V3=https://api.xkiro.com/v1

# Default & deep sama-sama xKiro; fallback otomatis ke key xKiro berikutnya,
# lalu Gemini, lalu Groq. Key yang kosong otomatis dilewati.
DEFAULT_PROVIDER=xkiro
DEEP_PROVIDER=xkiro

# === Hermes Agent (opsional; /hermes <tugas>) ===
# Agent CLI dari Nous Research. Tetap memakai key xKiro di atas (tanpa key baru).
# Toolset sengaja dimatikan supaya agent tidak jalanin shell/file dari Telegram.
HERMES_ENABLED=true
# HERMES_API_KEY=...          # opsional; kalau diisi, dipakai paling pertama
HERMES_MODEL=mistralai/mistral-large-2512
# HERMES_BASE_URL=https://api.xkiro.com/v1
# HERMES_CONTEXT_LENGTH=256000
# HERMES_TIMEOUT_MS=180000
# HERMES_MAX_CHARS=3500
# HERMES_HOME=/app/.hermes   # Railway sudah mengisi otomatis
# HERMES_BIN=/app/.hermes-bin/hermes

# === Google Sheets (opsional; kalau kosong, logging dimatikan) ===
GOOGLE_SHEETS_ID=...
# Isi service-account JSON yang sudah di-base64:
#   base64 -w0 service-account.json
GOOGLE_SA_B64=...

# === Budget & operasional ===
# Budget harian untuk laporan biaya (/stats, /budget); tidak membatasi provider.
DAILY_BUDGET_USD=1.00
LOG_LEVEL=info
TZ=Asia/Jakarta
# PORT diisi otomatis oleh Railway. Untuk lokal yang PORT-nya sudah dipakai
# proses lain, set HEALTH_PORT.
# PORT=8080
# HEALTH_PORT=8080
